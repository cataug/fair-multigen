# ============================================================================
# MultiFairGDT / fair-multigen
# Keep source, scripts, logs, statistics, CSV results and figures.
# Exclude environments, raw datasets, caches and large model checkpoints.
# ============================================================================


# ----------------------------------------------------------------------------
# Python environments
# ----------------------------------------------------------------------------
.venv/
.venv_*/
venv/
venv_*/
env/
env_*/


# ----------------------------------------------------------------------------
# Python caches / tooling caches
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
coverage.xml
htmlcov/


# ----------------------------------------------------------------------------
# IDE / OS junk
# ----------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~


# ----------------------------------------------------------------------------
# Raw datasets / downloaded corpora
#
# If a lightweight metadata file is required for the paper, move/copy it
# outside these raw-data directories before committing.
# ----------------------------------------------------------------------------
data/
dataset/
datasets/
raw_data/
raw-data/
downloads/
download/
external_data/
external-data/
cache/
.cache/


# Common compressed/raw dataset formats
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.bz2
*.xz
*.gz


# ----------------------------------------------------------------------------
# Heavy ML checkpoints / weights
#
# Important: logs/results remain tracked. Only model-state binaries are ignored.
# ----------------------------------------------------------------------------
checkpoints/
results/journal2026_v21/checkpoints/

*.ckpt
*.pth
*.pt
*.safetensors
*.onnx


# ----------------------------------------------------------------------------
# Other potentially huge binary artifacts
# ----------------------------------------------------------------------------
*.avi
*.mp4
*.mov
*.mkv
*.wav
*.flac


# ----------------------------------------------------------------------------
# Temporary files
# ----------------------------------------------------------------------------
*.tmp
*.temp
*.lock
*.pid


