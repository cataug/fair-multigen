.gitignore.backup_*

# Jupyter-generated cache folders everywhere
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Dataset payloads: keep code/manifests, exclude actual datasets
fairness_datasets/raw/
fairness_datasets/processed/

